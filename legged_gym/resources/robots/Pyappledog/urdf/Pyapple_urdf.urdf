<?xml version="1.0" ?>
<robot name="pyapple_a1style_8dof">

  <!-- ===================== BASE ===================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.00007 0.00037 -0.01954" rpy="0 0 0"/>
      <mass value="0.286"/>
      <inertia ixx="3.7972492e-04" ixy="-1.62752e-06" ixz="3.0157e-07"
               iyy="9.1991088e-04" iyz="-2.4241e-07" izz="1.21659366e-03"/>
    </inertial>

    <visual name="base_link_visual">
      <origin xyz="0 0 -0.0195" rpy="0 0 0"/>
      <geometry>
        <box size="0.105 0.1 0.039"/>
      </geometry>
    </visual>

    <collision name="base_link_collision">
      <origin xyz="0 0 -0.0195" rpy="0 0 0"/>
      <geometry>
        <box size="0.105 0.1 0.039"/>
      </geometry>
    </collision>
  </link>

  <!-- =====================================================================================
       A1-style naming + A1-style foot mode + keep 8DoF
       - Each leg has 2 revolute joints: *_hip_joint, *_thigh_joint  => 8DoF total
       - *_calf_joint is FIXED (name matches A1 but does NOT add DoF)
       - *_foot_fixed is FIXED + dont_collapse="true"
       - Foot contact is ONLY on *_foot
  ====================================================================================== -->

  <!-- ===================== FRONT RIGHT (FR) ===================== -->
  <link name="FR_hip">
    <inertial>
      <origin xyz="-0.00691599912245249 -0.0063449824773732 -0.0203999860807895" rpy="0 0 0"/>
      <mass value="0.0347"/>
      <inertia ixx="2.200159e-05" ixy="-3.3399e-07" ixz="1.37039e-06"
               iyy="2.345919e-05" iyz="-8.885e-07" izz="4.39726e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.01 -0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.01 0.08"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.01 -0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.01 0.08"/>
      </geometry>
    </collision>
  </link>

  <joint name="FR_hip_joint" type="revolute">
    <origin xyz="0.07121 -0.0564 -0.0187" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="FR_hip"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="0.392" velocity="4"/>
  </joint>

  <link name="FR_thigh">
    <inertial>
      <origin xyz="-7.64699287002096E-05 0.00525000002321452 0.027600037649329" rpy="0 0 0"/>
